  "methods": [
    {
      "id": "bounded-source-crosswalk",
      "kind": "source",
      "description": "Read the preserved 2017 geoBoundaries source and current Kiribati feature parts, inventory every component bounding box, and compare rectangle candidates with retained current subjects and #526 OSM source land. Census rows and source-role facts are transcribed from source receipts. This is candidate screening only, not polygon overlay or area measurement.",
      "software": "Python 3.12.4; standard-library JSON/XML/hashlib; no GIS geometry operation",
      "units": "WGS84 longitude/latitude degrees for component bounds; counts are inventory counts only"
    }
  ],
