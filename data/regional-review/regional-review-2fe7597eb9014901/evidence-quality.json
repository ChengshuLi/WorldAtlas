  "methods": [
    {
      "id": "published-v5-parent-and-scope-review",
      "description": "Extract exact current issue-owned location features, all complete parent chains and direct province/area/region membership from published v5 and official textual sources; inspect each of four locations and all eight singleton wrappers.",
      "software": "Python 3; repository baseline extraction script",
      "units": "location subjects, parent/member IDs"
    },
    {
      "id": "shoreline-candidate-screen",
      "kind": "geography",
      "description": "Enumerate every GSHHG high-resolution L1 polygon intersecting the four explicit WGS84 windows; project with always-XY coordinates to EPSG:6933; compare polygon distance and area to target atlas locations.",
      "software": "PyShp 2.3.1; Shapely 2.1.2; pyproj 3.7.2",
      "units": "km2, m, polygon record count",
      "axis_order": "longitude-latitude",
      "crs": "EPSG:6933 (World Equidistant Cylindrical) for area/distance; source coordinates WGS84 longitude-latitude",
      "area_method": "Shapely planar polygon area in EPSG:6933, divided by 1,000,000; threshold >1 km2 is diagnostic only",
      "distance_method": "Shapely polygon-to-polygon minimum Euclidean distance in EPSG:6933; 500 m is a diagnostic screen only"
    },
    {
      "id": "canonical-grid-readonly-audit",
      "kind": "geography",
      "description": "Verify every compressed and decoded current v5 canonical ownership run chunk against manifest; decode exact run intervals and sum cell counts for the four target feature indexes.",
      "software": "Node.js 24; repository src/ownership-codec.js",
      "units": "assigned canonical cells",
      "axis_order": "longitude-latitude",
      "crs": "Canonical grid v2 packing; no new projection performed",
      "area_method": "Not applicable: count encoded owner-cell intervals, not geographic area",
      "distance_method": "Not applicable: this method computes no distance"
    }
  ],
