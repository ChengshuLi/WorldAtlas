      "editable": true,
      "domain": null,
      "defaultValue": "",
      "description": "{\"value\":\"Term describing the type of feature the geographical name is associated with often, the name itself can be misleading e.g. Pike River in Quebec is a Village, not a River.\",\"fieldValueType\":\"typeOrCategory\"}"
    },
    {
