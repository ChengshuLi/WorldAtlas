{"help": "https://data.gov.hr/ckan/api/3/action/help_show?name=package_show", "success": true, "result": {"access_rights": "public", "applicable_legislation": "", "author": "", "author_email": "", "coordinator": "", "coordinator_email": "", "creator_user_id": "baafe451-1392-4392-ab62-052278b7cdd0", "data_refresh_frequency": "", "hvd_category": "", "id": "60f2b7d7-127b-4c53-b56e-6960b8a50458", "isopen": false, "license_id": "open-license", "license_title": "Otvorena dozvola (OD)", "license_url": "https://data.gov.hr/id/licence/otvorena-dozvola-rh", "maintainer": null, "maintainer_email": null, "metadata_created": "2021-05-05T11:47:32.825193", "metadata_modified": "2026-04-15T19:12:05.525134", "name": "popis-zupanija-gradova-i-opcina", "notes": "U Republici Hrvatskoj ustrojeno je ukupno 555 jedinica lokalne samouprave, i to 428 op\u0107ina i 127 gradova te 20 jedinica podru\u010dne (regionalne) samouprave, odnosno \u017eupanija. Grad Zagreb, kao glavni grad Republike Hrvatske, ima poseban status grada i \u017eupanije, tako da je u Republici Hrvatskoj sveukupno 576 jedinica lokalne i podru\u010dne (regionalne) samouprave.", "num_resources": 3, "num_tags": 4, "organization": {"id": "a1c0e3ee-b6e9-45d7-85b6-17b6eb11bd89", "name": "ministarstvo-pravosudja", "title": "Ministarstvo pravosu\u0111a, uprave i digitalne transformacije", "type": "organization", "description": "Ministarstvo pravosu\u0111a, uprave i digitalne transformacije obavlja upravne i druge poslove koji se odnose na: podru\u010dje gra\u0111anskog, kaznenog, prekr\u0161ajnog i trgova\u010dkog prava te upravnog sudovanja; ustrojstvo i rad te stru\u010dno osposobljavanje u tijelima koja izvr\u0161avaju kaznene i prekr\u0161ajne sankcije, upravne i druge poslove u javnom bilje\u017eni\u0161tvu i odvjetni\u0161tvu; sudske i javnobilje\u017eni\u010dke pristojbe; me\u0111unarodnu pravnu pomo\u0107 i druge oblike pravne pomo\u0107i; izvr\u0161avanje kaznenih i prekr\u0161ajnih sankcija, pomilovanja i uvjetne otpuste; upravne i stru\u010dne probacijske poslove pri odlu\u010divanju o kaznenom progonu te izboru vrste i mjere kaznenopravnih sankcija, izvr\u0161avanje kaznenopravnih sankcija izre\u010denih punoljetnim po\u010diniteljima kaznenih djela, a koje se izvr\u0161avaju na slobodi; poslove razvoja i koordinacije sustava podr\u0161ke \u017ertvama i svjedocima te informatizaciju pravosu\u0111a.", "image_url": "", "created": "2021-05-05T08:53:25.467023", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "a1c0e3ee-b6e9-45d7-85b6-17b6eb11bd89", "private": false, "state": "active", "theme": "government_and_public_sector", "title": "Popis \u017eupanija, gradova i op\u0107ina", "type": "dataset", "url": "", "version": "", "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2015-11-03T17:00:35.358159", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Popis \u017eupanija, gradova i op\u0107ina", "format": "HTML", "hash": "", "id": "5da49db6-7f23-4682-afcb-31201d772335", "last_checked_date": "2023-02-19", "last_modified": "2023-02-19T23:22:42.018211", "metadata_modified": "2024-04-04T16:09:02.205089", "mimetype": null, "mimetype_inner": null, "name": "", "openess": 0, "package_id": "60f2b7d7-127b-4c53-b56e-6960b8a50458", "position": 0, "resource_availability": "available", "resource_type": "documentation", "size": null, "state": "active", "url": "https://mpu.gov.hr/gradjani-21417/iz-djelokruga/lokalna-i-podrucna-regionalna-samouprava-24398/popis-zupanija-gradova-i-opcina-24402/24402", "url_type": null}, {"cache_last_updated": null, "cache_url": null, "ckan_url": "https://data.gov.hr", "created": "2015-11-03T17:00:35.358200", "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "description": "Popis op\u0107ina i gradova u Republici Hrvatskoj", "format": "XLS", "hash": "b09fd8541ed8912f8363daaa6ead74eb", "id": "55ac291b-63bf-42ac-8d01-7aff77c62223"