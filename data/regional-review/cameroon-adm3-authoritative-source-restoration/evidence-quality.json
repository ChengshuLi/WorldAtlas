      "id": "cmr-adm3-ocha-spatial-candidate-crosswalk",
      "kind": "measurement",
      "description": "Compare each scoped 2017 geoBoundaries polygon to all OCHA ADM3 polygons. Normalize Unicode names and parents; use Shapely STRtree for intersecting candidates and PyProj WGS84 ellipsoidal area for intersection-over-union and two-sided coverage. Apply Shapely make_valid in memory only for invalid geometry. A candidate link is not legal identity proof.",
      "software": "Python 3.12; Shapely 2.1.2; PyProj 3.7.2; PROJ 9.5.1",
      "crs": "EPSG:4326",
      "axis_order": "longitude-latitude",
      "area_method": "PyProj Geod(ellps=WGS84).geometry_area_perimeter for intersection, union and each polygon; absolute ellipsoidal square metres.",
      "distance_method": "No distance measured; intersecting spatial candidates ranked by IoU.",
      "units": "square metres intermediate; unitless IoU/coverage and feature/component counts"
    }
