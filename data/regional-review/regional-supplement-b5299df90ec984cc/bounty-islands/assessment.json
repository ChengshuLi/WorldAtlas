  "location": {
    "id": "atlas:macro-coverage:location:73281d3672f84a47a770",
    "name": "Bounty Islands",
    "classification": "insufficient-evidence for exact whole-land coverage; named archipelago association is justified, proposed reference-footprint correction is needed",
    "role": "Named multi-island physical group in New Zealand’s subantarctic islands. DOC describes 22 granite rocks divided approximately into Main, Centre and East groups. One named archipelago subject; rocks/islets are not automatically separate atlas locations.",
    "settlements": "DOC describes a remote group without safe anchorage or easy landing; it does not identify permanent settlements. No settlement evidence for any source ring was found in the retained extract.",
    "proposal": "Retain one location for the complete named Bounty Islands group and its fixed parent route. Integrate reference geometry only after resolving DOC 135 ha, OSM 50.156 ha and GSHHG 276.964 ha and producing a source-supported crosswalk. No geography edit in this evidence packet.",
    "unresolved": [
      "Official 22-rock count is not accompanied by a complete feature-by-feature name list or survey boundary on the reviewed DOC page.",
      "All 27 OSM coastline ways are anonymous; exact mapping of 27 rings to DOC’s 22 rocks is unknown.",
      "Fourteen GSHHG polygons have no verified crosswalk to the OSM rings or DOC island groups.",
      "OSM and GSHHG dry-land areas differ by over fivefold; both differ materially from DOC’s approximate area. Tide, generalization, vintage, and method are unreconciled.",
      "Complete modern physical shoreline is not certified; unnamed rocks omitted from the extract remain possible."
    ]
  },
  "province": {
    "id": "atlas:macro-coverage:province:e97e94b1d0009c0b8cf4",
    "name": "Bounty Islands",
    "classification": "insufficient evidence for an independent administrative/semantic tier; the one-child province is coextensive in intended scope with its named-island location",
    "finding": "No ordinary administrative district or local-government province is evidenced for this remote island group. The issue source hint says no invented modern county. This appears to be a geographic wrapper; the analogous single-child wrappers among sibling outlying groups do not independently justify repeating this tier.",
    "proposal": "Do not change shared hierarchy here. Regional integration should document a consistent policy exception for coextensive geographic wrappers across all six area members or propose a coordinated tier simplification."
  },
