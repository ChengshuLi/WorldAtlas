  "lane": "geography",
  "methods": [
    {
      "description": "Extract the exact 34 issue IDs from the pinned LFS source; reproduce against retained 34-feature extract; join them to records in all 36 immutable current-main index parts. Direct source/Atlas hashes differ after coordinate rounding and simplification; method does not adjudicate boundary accuracy.",
      "id": "source-id-reproduction",
      "kind": "code",
      "software": "Python 3 bundled runtime; Git blobs at baseline f1a6c0abc29de7bf7b7a081a8a9864b0450c0427",
      "units": "unique feature IDs; whole-file SHA-256; coordinate positions (example only)"
    },
    {
      "description": "Inspect geoBoundaries metadata and feature names; inspect regional Law 215-OZ reference, consolidated 104-OZ copy and indexed text of Laws 46-OZ, 47-OZ and 45-OZ. No current legal polygon overlay performed.",
      "id": "legal-source-review",
      "kind": "source",
      "software": "Manual source inspection and web search, 2026-10-05 America/Los_Angeles",
      "units": "named legal entities and effective dates; no geographic measurement"
    },
    {
      "id": "authalic-area-size-screen",
      "kind": "measurement",
      "description": "For each exact issue-396 source polygon and matched Atlas polygon at the immutable PR-base commit, compute an authalic-sphere longitude-latitude ring-integral approximation; sum components and subtract holes. Compare aggregate and maximum feature sizes with the official agency page rounded estimate. This identifies scale and per-record area deltas only; no ellipsoidal measurement, union, overlap, boundary or adjacency test. Positive control uses the analytic area of a one-degree equatorial rectangle; negative control rejects a declared hole larger than its exterior.",
      "software": "Python 3.12.14 standard library; baseline Git blobs from 7f23b59fe66c0deb57d88115092f2126d6916505",
      "units": "square kilometres; ratio of source and Atlas approximate areas"
    },
    {
      "id": "administrative-role-change-review",
      "kind": "source",
      "description": "Reviewed official portal search listing for Law 18-OZ and secondary-hosted indexed legal text; checked 2026 Law 20-OZ listing. Exact official Law 18-OZ text bytes and operative Law 20-OZ text were inaccessible; no polygon correspondence inferred.",
      "software": "Manual official-publication search and legal text search, 2026-10-05 America/Los_Angeles",
      "units": "legal effective dates and named administrative-role changes; no boundary measurement"
    }
  ],
