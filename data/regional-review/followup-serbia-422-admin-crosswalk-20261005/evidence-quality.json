    {
      "id": "exact-source-and-register-crosswalk",
      "kind": "code",
      "description": "Match issue-scoped Atlas IDs and original source names against the byte-retained original 145-feature layer, the SORS 2017 registration list and current-state SORS roster. Normalize Serbian Cyrillic/Latin names, preserve source codes and compare parent/type relationships. Independently count distinct current primary registration codes per each of the exact 13 parents and test set equality.",
      "software": "Python 3.8.5; pandas 1.1.3; xlrd 1.2.0; openpyxl 3.0.5; reproduce.py",
      "units": "feature IDs, names, official registration codes/types, district/city parent codes and exact roster membership sets"
    }
  ],
