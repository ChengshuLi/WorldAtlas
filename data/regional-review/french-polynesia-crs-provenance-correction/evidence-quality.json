      "source_ids": [
        "daf-rgpf"
      ],
      "status": "supported",
      "text": "The three DAF archive PRJ files declare RGPF / GRS 1980 (EPSG:4687), not EPSG:4326."
    },
    {
      "source_ids": [
        "rfc7946",
        "proj-epsg-db"
      ],
      "status": "supported",
      "text": "Mapshaper default export does not perform a meaningful RGPF-to-WGS84 datum transformation; GeoJSON RFC 7946 semantics therefore require an explicit operation before native RGPF values are represented as WGS84."
    },
    {
      "source_ids": [
        "proj-epsg-db"
      ],
      "status": "unresolved",
      "text": "EPSG:8828 and EPSG:15833 are candidate sensitivity operations only; DAF intent and production operation remain unresolved."
    },
    {
      "source_ids": [
        "daf-catalog",
        "daf-rgpf",
        "commune-decrees"
      ],
      "status": "unresolved",
      "text": "The source polygons, 2026 legal currency, full island/reef/bank completeness, and downstream authorization remain unresolved."
    }
