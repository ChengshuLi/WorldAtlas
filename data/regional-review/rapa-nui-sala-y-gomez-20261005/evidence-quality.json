  "issue": 1052,
  "lane": "geography",
  "methods": [
    {
      "description": "Check exact retained native shapeID, source name, boundary type, canonical unit label, source lineage, update/build dates and license. Select the remote source component by coverage of the official Decreto 324 coordinate, not component order or component count.",
      "id": "source-crosswalk",
      "kind": "source",
      "software": "Python 3.12.14 standard library; immutable Git blobs at pinned baseline",
      "units": "native feature IDs, source metadata, longitude/latitude coordinates"
    },
    {
      "area_method": "WGS84 straight-source-edge ellipsoidal integral",
      "axis_order": "longitude-latitude",
      "crs": "EPSG:4326",
      "description": "Compare only the exact source component covering the decree coordinate with the current Atlas feature; compute WGS84 land areas/intersection and geodesic distance using the shared helper. The mainland intersection and axis-order point are positive controls; the remote component’s zero current overlap is a negative inclusion control.",
      "distance_method": "WGS84 inverse geodesic",
      "helper_version": "worldatlas-evidence-geometry-v1",
      "id": "geodesic-overlays",
      "kind": "geography",
      "software": "Python 3.12.14; NumPy 2.3.5; Shapely 2.1.2; pyproj 3.7.2; worldatlas-evidence-geometry-v1",
      "units": "m² and metres"
    },
    {
      "description": "Restore the two cited official RAR archives by URL and exact hash; parse the EPSG:32712 line/polygon SHP and DBF records without repairing geometry; transform with explicit longitude-first pyproj and confirm the decree coordinate is within the polygon layer and the nearby offshore negative point is outside. Raw source files are not redistributed because reuse terms are unstated.",
      "id": "official-dpa-2022",
      "kind": "source",
      "software": "Python 3.12.14 standard library; pyproj 3.7.2; Shapely 2.1.2; bsdtar 3.7",
      "units": "feature records, EPSG:32712 coordinates, WGS84 longitude/latitude"
    },
    {
      "description": "Read exact file bytes from the immutable commit; assert the subject exists once in actual part-2 and zero times in issue-pinned part-28; verify parent and source identity; write deterministic JSON outputs only under the owned evidence directory.",
      "id": "packet-code",
      "kind": "code",
      "software": "Python 3.12.14; Git; Node.js 24 for evidence validation",
      "units": "file identities, features, bytes and SHA-256"
    }
  ],
