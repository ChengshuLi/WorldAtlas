  "conclusions": [
    {
      "text": "All 23 pinned issue subjects match one retained 2017 source feature and a same-period official MONSTAT municipality name/area row; this is an identity/name crosswalk and area triage, not boundary-position validation.",
      "status": "supported",
      "source_ids": [
        "geoboundaries-mne-adm1-2017",
        "monstat-2017-yearbook"
      ]
    },
    {
      "text": "No official reusable 2017 municipality geometry was obtained from inspected public sources; Cadastre/Spatial Units Register and official water geoportal are explicit restoration leads with unresolved bytes/vintage/reuse details.",
      "status": "unresolved",
      "source_ids": [
        "water-info-geoportal",
        "cadastre-spatial-units-register"
      ]
    },
    {
      "text": "The source comparison polygons have unverified legal boundary basis and island/coast completeness; no geometry approval or correction is supported.",
      "status": "unresolved",
      "source_ids": [
        "geoboundaries-mne-adm1-2017",
        "cadastre-spatial-units-register"
      ]
    },
    {
      "text": "MONSTAT tables identify an unexplained 157 km2 2017 area sum discrepancy; the 2018 report attributes its separate 226 km2 country/table difference to Lake Skadar and calls Tuzi area temporary pending demarcation.",
      "status": "supported",
      "source_ids": [
        "monstat-2017-yearbook",
        "monstat-2021-yearbook"
      ]
    },
    {
      "text": "Latest inspected Ministry statement reports agreement to arbitrate open Podgorica/Tuzi demarcation questions; final outcome/current geometry is not established.",
      "status": "unresolved",
      "source_ids": [
        "ministry-tuzi-demarcation"
      ]
    },
    {
      "text": "The current official municipality roster has 25 entries including Tuzi and Zeta, but is contact/name data and cannot verify boundary geometry.",
      "status": "supported",
      "source_ids": [
        "montenegro-current-municipality-roster"
      ]
    }
  ],
