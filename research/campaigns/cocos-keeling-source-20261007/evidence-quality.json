  "conclusions": [
    {
      "text": "GA metadata reports 15 cm ground pixel size, about 30 cm guide horizontal accuracy, 8–16 August 2011 acquisition and low-tide capture; these metadata statements do not establish target frame coverage or physical truth.",
      "status": "supported",
      "source_ids": [
        "ga-2011-orthophoto-metadata"
      ]
    },
    {
      "text": "Whether the 2011 orthophoto or LiDAR products are fit for this exact component remains unresolved because target-frame coverage, pixels, frame tides, detailed AAM report, and product/third-party rights were not established.",
      "status": "unresolved",
      "source_ids": [
        "ga-2011-orthophoto-product",
        "ga-2011-lidar-dem-product",
        "ga-2011-frame-tide-table",
        "ga-aam-survey-report"
      ]
    },
    {
      "text": "The 1987 imagery is not corroboration because target coverage and product reuse terms remain unknown; the metadata says island coverage only and lagoon excluded.",
      "status": "unresolved",
      "source_ids": [
        "ga-1987-orthophoto-metadata",
        "ga-1987-orthophoto-product"
      ]
    },
    {
      "text": "The small retained Coast Outline is a CC BY 4.0 derivative of the same DEM; its metadata warns about low-tide sandbanks and sand-flat accuracy. It is not independent shoreline evidence.",
      "status": "supported",
      "source_ids": [
        "datawa-coast-outline-2011"
      ]
    }
  ],
