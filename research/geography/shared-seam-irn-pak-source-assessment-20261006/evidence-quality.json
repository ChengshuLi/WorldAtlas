    },
    {
      "id": "whole-subject-overlay",
      "kind": "measurement",
      "description": "Transform source vertices from longitude/latitude WGS84 to EPSG:6933 with pyproj always_xy; compute planar polygon areas, intersection, union and IoU without densification. This is a whole-footprint discrepancy diagnostic, not a seam or accuracy method.",
      "software": "Python 3.12.14; Shapely 2.1.2; pyproj 3.7.2; producer commit 2ed630f9aef42b54a75f12fdae1f0c8caad9b1e3",
      "units": "square metres and dimensionless fractions",
      "axis_order": "longitude-latitude",
      "crs": "EPSG:4326 to EPSG:6933",
      "area_method": "planar equal-area overlay after transforming source vertices; no densification",
      "distance_method": "not used"
    },
    {
      "id": "osm-shared-edge-source-membership",
      "kind": "source",
      "description": "Compare exact OSM way objects, node sequences/coordinates, and membership in both county and national relations; exercise positive and negative controls.",
