  "methods": [
    {
      "id": "whole-subject-crosswalk",
      "kind": "source",
      "description": "Inspect exact provider identifiers, namesakes, OSM aliases/admin tiers/Wikidata IDs, and native parent chains to evaluate an authored cross-provider crosswalk.",
