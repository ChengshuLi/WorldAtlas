  	</body>
	<script>	
   	const isMobile = window.innerWidth <= 767;
	
	$('[id^=nomAgr_]').bind('click',function(event){
    	
		document.querySelectorAll('[id^="seriesAgr_"]').forEach((element, index) => {
            if (isMobile) {
                element.style.display = "none";
            }
    	});
		var codAgr=$(this).attr('id').split('_')[1];
		$('[id^=seriesAgr_'+codAgr+'_]').toggle();
	});
	
	$('[id^=linkArchivosSerie_]').bind('click',function(event){
		$('#codSerie').val($(this).attr('id').split('_')[1]);
		$('#numPagina').val("1");
		$('#codAgr,#comboComSerie,#comboProvSerie,#codIne,#numHoja,#comboTipoArchSerie,#comboIdiomaInfSerie,#idProductor,#todaEspania,#todoMundo,#rutaNombre,#comboTematica,#filtroOrderBy,#contieneArc,#referCatastral').val('');
		callArchivosTotSeries();
	});
		
	if($("#numSeries").val()==1){
		$('#codSerie').val($('[id^=linkArchivosSerie_]').attr('id').split('_')[1]);
		callArchivosTotSeries();
	}
		
		
	function callArchivosTotSeries(){
		$("#modalEsperaBuscando").show();
		$.ajax({
            url: 'archivosTotalesSerie',						
            data:{
            	numPagina:$('#numPagina').val(),
           	 	codAgr:$('#codAgr').val(),
           		codSerie:$('#codSerie').val(),
				coordenadas:$('#coordenadas').val(),
				series:$('#series').val(),
           		codComAutonoma:$('#comboComSerie').val(),
           		codProvincia:$('#comboProvSerie').val(),
           		codIne:$('#codIne').val(),
           		codTipoArchivo:$('#comboTipoArchSerie').val(),
           		codIdiomaInf:$('#comboIdiomaInfSerie').val(),
           		todaEspania:$('#todaEspania').val(),
           		todoMundo:$('#todoMundo').val(),
           		idProductor:$('#idProductor').val(),
           		rutaNombre:$('#rutaNombre').val(),
           		numHoja:$('#numHoja').val(),	 	
           		totalArchivos:$('#totalArchivos').val(),
           		codSubSerie:$('#comboTematica').val(),
           		contieneArc:$('#contieneArc').val(),
           		keySearch:$('#keySearchTotSer').val(),
           		referCatastral:$('#referCatastral').val(),
           		idProcShp:$('#idProcesoShape').val(),
           		orderBy:$('#filtroOrderBy').val()
            },
            success: buscarArchivosSerieOk,
            dataType: "html",
            error: function(xhr, ajaxOptions, thrownError){
            	$("#modalEsperaBuscando").hide();
            }		
    	});			
	}		

	function buscarArchivosSerieOk(htmlObj){

		$("#modalEsperaBuscando").hide();
		$('#capaListaArchivos').html(htmlObj);

		if(deviceType=='Mobile'){
			$('#trLATotSerieMov').focus();
		}
		else{
			$('#trLATotSerie').focus();	
		}
	}
	
	$('[id^=linkFaqs_]').bind('click',function(event){
		var option=$(this).attr('id').split('_')[1];
		
		$('.open').removeClass('open');		
		this.classList.toggle('open');
		
		if($('#txt_'+option).is(':visible')){
			$('#txt_'+option).slideUp();
			$('#linkFaqs_'+option).removeClass('open');
		}
		else{
			$('[id^=txt_]').slideUp();
			$('#txt_'+option).slideDown();
		}
	});		

	document.addEventListener('DOMContentLoaded', function() {
       	if (!isMobile) return;
		const nomAgrElements = Array.from(document.querySelectorAll('[id^="nomAgr_"]'));
	    if (nomAgrElements.length > 0) {
	        const firstNomAgr = nomAgrElements[0];
	        const allSeries = Array.from(document.querySelectorAll('[id^="seriesAgr_"]'));
	        let foundNextNomAgr = false;
	        let seriesToShow = [];
	        let nextElement = firstNomAgr.nextElementSibling;
	        while (nextElement && !foundNextNomAgr) {
	            if (nextElement.id && nextElement.id.startsWith('seriesAgr_')) {
	                seriesToShow.push(nextElement);
	            } 
	            else if (nextElement.id && nextElement.id.startsWith('nomAgr_')) {
	                foundNextNomAgr = true;
	            }
	            nextElement = nextElement.nextElementSibling;
	        }
	        allSeries.forEach(series => {
	            series.style.display = 'none';
	        });
	        seriesToShow.forEach(series => {
	            series.style.display = 'block';
	        });
	    }
	});
</script>	
	
</html>
