<!-- The Modal -->
<div id="modalBuscCab" class="modalBuscar">

  <!-- Modal content -->
  <div class="modal-content">
    <div class="modal-header col-12">
      <span id="closeBuscCab" class="cerrar" title="Cerrar">&times;</span>
    </div>
