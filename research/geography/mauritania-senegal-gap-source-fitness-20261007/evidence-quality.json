  "methods": [
    {
      "id": "full-consumed-product-source-fit",
      "description": "Verify byte-pinned full GeoJSON product feature rosters and geometries, then screen both exact candidate source features against every feature in both products without transformation or repair.",
      "software": "Python 3.12.14; Shapely 2.1.2; GEOS 3.13.1; source_fit.py SHA-256 b09f0393f4b2b7767a316c03eba55dc4814c60bca5f701a37cca8cc96d84929b",
      "units": "Coordinates in source GeoJSON longitude/latitude degrees; intersection diagnostic in degree-squared; no metric area/distance computed.",
      "kind": "geography",
      "crs": "WGS 84 / RFC 7946 GeoJSON",
      "axis_order": "longitude-latitude",
      "area_method": "Shapely/GEOS topological intersection in unmodified angular coordinates; area reported only as a numerically fragile degree-squared diagnostic.",
      "distance_method": "None."
    }
  ],
  "metrics": [],
  "summaries": [],
  "conclusions": [
    {
      "text": "Both candidate geometries are topologically covered by MRT Keur Macene in the pinned simplified product; the second also has a fragile intersection with SEN Dagana. This supports only administrative source-fit observations.",
      "status": "supported",
      "source_ids": [
        "geoboundaries-mrt-adm2",
        "geoboundaries-sen-adm2"
      ]
    },
    {
      "text": "Physical land-versus-inland-water classification and a safe physical geometry repair remain unresolved; no date-matched independent surface observation at suitable positional precision is available in this assessment.",
      "status": "unresolved",
      "source_ids": [
        "geoboundaries-mrt-adm2",
        "geoboundaries-sen-adm2"
      ]
    }
  ],
