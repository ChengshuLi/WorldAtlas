      "units": "coordinate pairs; degrees; SHA-256",
      "axis_order": "longitude-latitude",
      "crs": "EPSG:4326",
      "area_method": "WGS84 straight-source-edge ellipsoidal integral",
      "distance_method": "WGS84 inverse geodesic"
    },
    {
      "id": "epsg6933-area-comparison",
      "kind": "measurement",
      "description": "Transform source and atlas geometries from EPSG:4326 to EPSG:6933 with always_xy longitude-latitude order, then compare projected planar area; cross-check shared WGS84 geodesic helper areas.",
      "software": "PyProj 3.7.2; Shapely 2.1.2; worldatlas-evidence-geometry-v1",
      "units": "km² and m²"
    },
    {
      "id": "historical-pin-validation",
