    {
      "id": "subject-geometry-comparison",
      "kind": "geography",
      "helper_version": "worldatlas-evidence-geometry-v1",
      "description": "Compare retained Natural Earth source rows to ancestor-main atlas geometries by canonical JSON object hashes (sorted keys, compact encoding; coordinate/ring order retained), coordinate counts, bounds and parent chain. EPSG:4326 longitude-latitude coordinates; no boundary suitability inference.",
