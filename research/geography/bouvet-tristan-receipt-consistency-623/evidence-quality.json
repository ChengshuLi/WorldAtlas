    {
      "id": "pinned-shoreline-ledger",
      "kind": "generator",
      "helper_version": "worldatlas-evidence-preparation-v1",
      "description": "Read only the exact ancestor-commit README and shoreline JSON bytes; validate declared count, all unique source IDs, and three named contexts; serialize findings deterministically.",
