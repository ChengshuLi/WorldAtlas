  {
    "source_family": "gb:COG:ADM2",
    "actual_xml_path": "native-source-custody-002/COG_ADM2/COG_ADM2.shp.xml",
    "bytes": 45811,
    "sha256": "0813ed0f0e234baf88845198068f3b963f3cb942799f15fc50754902de3a2753",
    "source_rights_fields": [
      {
        "tag": "idPurp",
        "text": "The Map Library is a project of the UK charity “The Map Maker Trust.\" It aims to make public domain mapping data more readily available for development in all kinds of fields, from health care to urban management, from de-mining to environmental protection."
      },
      {
        "tag": "idAbs",
        "text": "<DIV STYLE=\"text-align:Left;\"><DIV><DIV><P><SPAN>This polygon shapefile contains district and commune boundaries for the Republic of the Congo as of January 2007. This layer is part of the Map Library dataset containing line and polygon boundaries for individual countries on the African continent.</SPAN></P></DIV></DIV></DIV>"
      },
      {
        "tag": "idCredit",
        "text": "Map Maker Ltd. (2007). Districts and Communes, Republic of the Congo, 2007 Map Maker, Ltd. Available at: http://purl.stanford.edu/hz799nq4536."
      },
      {
        "tag": "resTitle",
        "text": "Districts and Communes, Republic of the Congo, 2007"
      },
      {
        "tag": "pubDate",
        "text": "2007-01-01T00:00:00"
      },
      {
        "tag": "collTitle",
        "text": "The Map Library"
      },
      {
        "tag": "resTitle",
        "text": "lcsh"
      },
      {
        "tag": "resTitle",
        "text": "geonames"
      },
      {
        "tag": "resConst",
        "text": "This item is in the public domain. There are no restrictions on access or use."
      },
      {
        "tag": "resTitle",
        "text": "The Map Library"
      },
      {
        "tag": "resTitle",
        "text": "Feature catalog for Districts and Communes, Republic of the Congo, 2007"
      }
    ]
  },
