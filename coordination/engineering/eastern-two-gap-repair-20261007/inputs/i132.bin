 // archives do not establish names or administrative memberships.
 const metadataFiles=(descriptor.metadata_receipts??[]).map(pinned),metadataGroups=new Map(current.units.map(u=>[u.id,u])),metadataProperties=new Map(current.features.map(f=>[f.id,f.properties]));
 for(const [ordinal,file] of metadataFiles.entries()){const receipt=read(file);
  if(ordinal===0&&receipt.before_hierarchy_sha256&&current.hierarchy&&receipt.before_hierarchy_sha256!==current.hierarchy)throw Error('Metadata predecessor hierarchy pin differs');
  if(receipt.reference_only!==true||receipt.historical_claims_transferred!==false||!Array.isArray(receipt.before_units)||!Array.isArray(receipt.group_changes)||!Array.isArray(receipt.changed_location_properties)||receipt.retired_units?.length||receipt.relationships?.some(r=>r.history_transfer!==false)||!receipt.source_evidence?.length||receipt.source_evidence.some(e=>!/^https?:\/\//.test(e.url??'')||!/^[a-f0-9]{64}$/.test(e.source_sha256??'')))throw Error('Metadata source-name proof is incomplete or transfers history');
  const archived=new Map(receipt.before_units.map(u=>[u.id,u]));if(archived.size!==receipt.before_units.length||!sameIds(new Set(archived.keys()),new Set(metadataGroups.keys()))||[...archived].some(([id,u])=>canonical(u)!==canonical(metadataGroups.get(id))))throw Error('Metadata proof changes exact predecessor groups');
  const seenGroups=new Set(),seenLocations=new Set();
  for(const delta of receipt.group_changes){if(seenGroups.has(delta.id)||delta.before?.id!==delta.id||delta.after?.id!==delta.id||canonical(delta.before)!==canonical(metadataGroups.get(delta.id))||delta.before.level!==delta.after.level)throw Error('Metadata group before/after evidence differs');seenGroups.add(delta.id);metadataGroups.set(delta.id,delta.after);}
  for(const delta of receipt.changed_location_properties){if(seenLocations.has(delta.location_id)||delta.before_properties?.id!==delta.location_id||delta.after_properties?.id!==delta.location_id||canonical(delta.before_properties)!==canonical(metadataProperties.get(delta.location_id)))throw Error('Metadata location before/after evidence differs');seenLocations.add(delta.location_id);metadataProperties.set(delta.location_id,delta.after_properties);}
 }
 if(chain.baselineFeatures.some(f=>canonical(f.properties)!==canonical(metadataProperties.get(f.id))))throw Error('Unreceipted reference name, parent or location metadata change');
 const immediate=rows=>{const counts=new Map();for(const row of rows)if(row.parent_id)counts.set(row.parent_id,(counts.get(row.parent_id)??0)+1);return counts;},oldCounts=immediate([...metadataProperties.values(),...metadataGroups.values()]),newCounts=immediate([...next.features.map(f=>f.properties),...next.units]),finalGroups=new Map(next.units.map(u=>[u.id,u]));
 for(const [id,original] of metadataGroups){const before=structuredClone(original),after=structuredClone(finalGroups.get(id));if(!after)throw Error('Existing metadata group was retired without evidence');if(before.metadata?.child_count!==after.metadata?.child_count){if(before.metadata?.child_count!==oldCounts.get(id)||after.metadata?.child_count!==newCounts.get(id))throw Error('Parent child count is not independently derived');delete before.metadata.child_count;delete after.metadata.child_count;}if(canonical(before)!==canonical(after))throw Error('Unreceipted reference group metadata change');}
 return {files,chain,metadataFiles};
}
function verifyPrepared(opts,current,next){const ownership=read(path.join(opts.ownership,'index.json')),references=read(path.join(opts.references,'index.json')),runtime=read(path.join(opts.runtime,'index.json')),sourceReceipt=read(opts.sourceReceipt),macroReceipt=read(opts.macroReceipt),referenceReceipt=read(path.join(opts.references,'incremental-receipt.json'));
