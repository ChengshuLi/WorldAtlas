 const proofMap=new Map(chain.proofs.flatMap(p=>p.creationProofs.map(row=>[row.location_id,row]))),normalize=row=>{const copy=structuredClone(row);delete copy.source.path;return canonical(copy);};
 for(const proof of proofs){if(!proofMap.has(proof.location_id)||normalize(proof)!==normalize(proofMap.get(proof.location_id)))throw Error('Compound creation proof differs from pinned child proof');const file=safe(path.dirname(opts.sourceReceipt),proof.source.path);if(fileHash(file)!==proof.source.sha256)throw Error('Compound creation source bytes changed');const rel=path.relative(base,file);safe(base,rel);files[rel]=proof.source.sha256;}
 for(const proof of chain.proofs)for(const member of Object.values(proof.files)){const rel=path.relative(base,member.file);safe(base,rel);files[rel]=member.sha256;}
