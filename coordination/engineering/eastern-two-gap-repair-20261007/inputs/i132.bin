 const summary={version:1,installer_sha256:fileHash(fileURLToPath(import.meta.url)),predecessor_files:treeManifest(opts.data),counts_before:current.counts,counts_after:next.counts,before_footprints_sha256:current.footprints,after_footprints_sha256:next.footprints,after_hierarchy_sha256:next.hierarchy,sources,grid:{zoom:grid.pixelAudit.grid_zoom,locations:next.ids.size,represented:next.ids.size,missing:0,high_distortion:grid.pixelAudit.high_distortion.length,manifest_sha256:fileHash(path.join(opts.grid,'manifest.json'))},namibia:prepared.namibia,source_catalog_mutated:false,sqlite_mutated:false,historical_claims_transferred:false};const validationHash=hash(JSON.stringify(summary));if(options.expectedValidation&&options.expectedValidation!==validationHash)throw Error('Validation differs from the approved dry-run hash');return {opts,current,next,prepared,grid,summary,validationHash};}
export function install(options,{apply=false,failAfter=Infinity}={}){const result=validate(options);if(!apply)return {dry_run:true,validation_sha256:result.validationHash,...result.summary};if(!options.expectedValidation)throw Error('Applying requires the explicit validated dry-run hash');const {opts}=result;const lock=path.join(opts.data,'.geography-install.lock');let fd;try{fd=fs.openSync(lock,'wx');}catch{throw Error('Another geography install or incomplete transaction holds the lock');}const backup=path.join(path.dirname(opts.data),'.cache/geography-install-backups',randomUUID()),staging=path.join(path.dirname(opts.data),'.cache/geography-install-staging',randomUUID());fs.mkdirSync(backup,{recursive:true});fs.mkdirSync(staging,{recursive:true});const changes=[],journal={version:1,state:'staging',validation_sha256:result.validationHash,backup,changes};const journalFile=path.join(backup,'journal.json');const save=()=>fs.writeFileSync(journalFile,JSON.stringify(journal));
 try{for(const [key,target] of [['geography','geography'],['ownership','ownership-history'],['runtime','ownership-runtime'],['references','reference-attributes'],['grid','canonical-grid']])fs.cpSync(key==='geography'?path.join(opts.geography,'geography'):opts[key],path.join(staging,target),{recursive:true,errorOnExist:true});for(const name of ['world-index.json','hierarchy.json'])fs.copyFileSync(path.join(opts.geography,name),path.join(staging,name));fs.writeFileSync(path.join(staging,'pixel-audit.json'),JSON.stringify(result.grid.pixelAudit));fs.writeFileSync(path.join(staging,'publication-geography-receipt.json'),JSON.stringify({...result.summary,validation_sha256:result.validationHash,rollback_backup:backup,transaction_journal:journalFile,commit_semantics:'Controlled local multi-path transaction with atomic individual renames and rollback; deployed Site generations publish atomically.'}));
 // Verify staged candidates again before replacing any live path.
 for(const [key,target] of [['ownership','ownership-history'],['runtime','ownership-runtime'],['references','reference-attributes'],['grid','canonical-grid']])if(JSON.stringify(treeManifest(path.join(staging,target)))!==JSON.stringify(result.summary.sources[key]))throw Error('Stage copy changed source bytes');for(const [name,expected] of Object.entries(result.summary.sources.geography))if(fileHash(safe(staging,name))!==expected)throw Error('Stage geography bytes changed');if(footprintHash(dataset(opts.data).features)!==result.current.footprints)throw Error('Live geography changed while staging');const currentFiles=treeManifest(opts.data);delete currentFiles['.geography-install.lock'];if(JSON.stringify(currentFiles)!==JSON.stringify(result.summary.predecessor_files))throw Error('Predecessor files changed while staging');
 journal.state='committing';save();const targets=['geography','hierarchy.json','ownership-history','ownership-runtime','reference-attributes','canonical-grid','pixel-audit.json','world-index.json','publication-geography-receipt.json'];for(const name of targets){const live=path.join(opts.data,name),old=path.join(backup,name),candidate=path.join(staging,name),entry={name,had_original:fs.existsSync(live),original_saved:false,candidate_installed:false};changes.push(entry);save();if(entry.had_original){fs.renameSync(live,old);entry.original_saved=true;save();}fs.renameSync(candidate,live);entry.candidate_installed=true;save();if(changes.length===failAfter)throw Error('Injected transaction failure');}journal.state='committed';save();fs.rmSync(staging,{recursive:true});return {applied:true,validation_sha256:result.validationHash,backup,journal:journalFile,...result.summary};
 }catch(error){journal.state='rolling-back';save();for(const entry of [...changes].reverse()){const live=path.join(opts.data,entry.name),old=path.join(backup,entry.name);if(entry.candidate_installed&&fs.existsSync(live))fs.renameSync(live,path.join(backup,'failed-'+entry.name));if(entry.original_saved)fs.renameSync(old,live);}journal.state='rolled-back';journal.error=String(error);save();throw error;}finally{fs.closeSync(fd);fs.unlinkSync(lock);}}
if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){const get=(key,fallback)=>process.argv.find(a=>a.startsWith('--'+key+'='))?.slice(key.length+3)??fallback;const options={data:get('data',path.join(root,'data')),geography:get('geography',path.join(root,'.cache/macro-boundary-repair-stage/after')),ownership:get('ownership',path.join(root,'.cache/source-territory-repair-stage/ownership-history')),runtime:get('runtime',path.join(root,'.cache/source-territory-repair-stage/ownership-runtime')),references:get('references',path.join(root,'.cache/source-territory-repair-stage/reference-attributes')),grid:get('grid',path.join(root,'.cache/final-grid-benchmark/10')),sourceReceipt:get('source-receipt',path.join(root,'.cache/source-territory-repair-stage/migration-receipt.json')),macroReceipt:get('macro-receipt',path.join(root,'.cache/macro-boundary-repair-stage/migration-receipt.json.gz')),gridAudit:get('grid-audit',path.join(root,'.cache/final-grid-assessment/zoom-10.json')),gridSourceAreas:get('grid-source-areas',path.join(root,'.cache/final-grid-assessment/wgs84-source-areas.json')),geometryProofs:get('geometry-proofs',undefined),expectedValidation:get('expected-validation',undefined)};console.log(JSON.stringify(install(options,{apply:process.argv.includes('--apply')})));}
