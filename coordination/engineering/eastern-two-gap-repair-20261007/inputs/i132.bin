 if(unitMap.size!==units.length)throw Error('Duplicate geographic group IDs');for(const u of units){const next=levels[levels.indexOf(u.level)+1];if(!levels.includes(u.level)||u.level==='location'||!u.name||u.name==='Antarctica'||(next?unitMap.get(u.parent_id)?.level!==next:u.parent_id!==null))throw Error('Invalid adjacent-tier group');counts[u.level]=(counts[u.level]??0)+1;}
 if(counts.continent!==6)throw Error('Exactly six continents are required');for(const f of features){if(!f.id||f.properties?.id!==f.id||ids.has(f.id)||!['Polygon','MultiPolygon'].includes(f.geometry?.type)||!f.geometry.coordinates?.length)throw Error('Invalid or duplicate location identity/footprint');ids.add(f.id);let parent=f.properties.parent_id;for(const tier of levels.slice(1)){const u=unitMap.get(parent);if(!u||u.level!==tier)throw Error('Incomplete location chain');members.set(parent,(members.get(parent)??0)+1);parent=u.parent_id;}if(parent!==null)throw Error('Invalid geographic root');}if(units.some(u=>!members.has(u.id)))throw Error('Empty geographic group');return {index,units,features,ids,counts,footprints:footprintHash(features),hierarchy:fileHash(path.join(directory,'hierarchy.json'))};}
function frozenGeometry(f){return JSON.stringify(f.geometry);}
const canonical=value=>JSON.stringify(value,(_,v)=>v&&typeof v==='object'&&!Array.isArray(v)?Object.fromEntries(Object.keys(v).sort().map(k=>[k,v[k]])):v);
const exactIds=(rows,label)=>{if(!Array.isArray(rows)||rows.some(id=>typeof id!=='string'||!id)||new Set(rows).size!==rows.length)throw Error('Invalid '+label+' inventory');return new Set(rows);};
const sameIds=(a,b)=>a.size===b.size&&[...a].every(id=>b.has(id));
export function verifySourceGeometry(opts,current,next,sourceReceipt){
