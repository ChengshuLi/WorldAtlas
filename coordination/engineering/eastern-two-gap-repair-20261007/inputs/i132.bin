 let referenceRecords=0;const seen=new Set();for(const name of references.parts){const expected=references.parts_sha256?.[name];if(!expected||fileHash(safe(opts.references,name))!==expected)throw Error('Reference part hash mismatch');for(const [id,rows] of read(safe(opts.references,name))){if(!next.ids.has(id))throw Error('Unregistered reference identity');for(const row of rows){const t=references.types[row[0]],value=references.values[row[1]];if(!t||row[1]<0||row[1]>=references.values.length||row.length!==4||t.valid_from===0||t.valid_to===0||t.valid_from>=t.valid_to)throw Error('Invalid reference tuple');const key=JSON.stringify([id,t.attribute,t.valid_from,t.valid_to]);if(seen.has(key))throw Error('Duplicate resolved reference interval');seen.add(key);referenceRecords++;}}}if(referenceRecords!==references.records)throw Error('Reference count mismatch');checkAsset(opts.references,referenceReceipt.archive);
 if(runtime.source_index_sha256!==fileHash(path.join(opts.ownership,'index.json'))||runtime.shared.footprints_sha256!==next.footprints||runtime.footprints_sha256!==next.footprints)throw Error('Temporal runtime is stale');for(const bucket of runtime.buckets)checkAsset(opts.runtime,bucket);
 // The unapproved Namibia replacement must not leak into this publication.
