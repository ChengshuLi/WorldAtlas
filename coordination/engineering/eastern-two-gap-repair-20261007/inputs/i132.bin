 if(fileHash(path.join(opts.references,'incremental-receipt.json'))!==references.incremental_preparation.receipt_sha256)throw Error('Reference preparation receipt hash mismatch');
 if(macroReceipt.historical_claims_transferred!==false||macroReceipt.source_repair_receipt_sha256!==fileHash(opts.sourceReceipt)||macroReceipt.unchanged_geometry_ids.length!==next.features.length||new Set(macroReceipt.unchanged_geometry_ids).size!==next.features.length||macroReceipt.unchanged_geometry_ids.some(id=>!next.ids.has(id))||Object.entries(next.counts).some(([key,value])=>macroReceipt.counts[key]!==value))throw Error('Macro migration receipt does not match the full candidate');
