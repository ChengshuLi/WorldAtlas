 if(proofs.length&&(created.size!==added.length||added.some(f=>!created.has(f.id))))throw Error('Creation inventory differs from exact new identities');
 if(!opts.geometryProofs){
  if(proofs.length){
   if(sourceReceipt.before_hierarchy_sha256&&sourceReceipt.before_hierarchy_sha256!==current.hierarchy)throw Error('Creation predecessor hierarchy changed');
   execFileSync('python3',[fileURLToPath(new URL('./validate-land-creations.py',import.meta.url))],{input:JSON.stringify({before:current.features,after:next.features,units:next.units,proofs,base:path.dirname(opts.sourceReceipt)}),maxBuffer:16*1024*1024});
  }return null;
 }
 const descriptor=read(opts.geometryProofs),base=path.dirname(opts.geometryProofs),files={[path.basename(opts.geometryProofs)]:fileHash(opts.geometryProofs)},seen=new Set();
 if(descriptor.version!==1||descriptor.before_footprints_sha256!==current.footprints||descriptor.after_footprints_sha256!==next.footprints||!Array.isArray(descriptor.manifests)||!descriptor.manifests.length)throw Error('Geometry proof sequence differs from exact current/candidate footprints');
 const pinned=row=>{if(!row||typeof row.path!=='string'||!/^[a-f0-9]{64}$/.test(row.sha256))throw Error('Invalid geometry evidence pin');const file=safe(base,row.path);if(seen.has(file)||fileHash(file)!==row.sha256)throw Error('Duplicate or changed geometry evidence pin');seen.add(file);files[path.relative(base,file)]=row.sha256;return file;};
 const manifestFiles=descriptor.manifests.map(pinned),chain=validateGeometryMigrations({features:next.features,baselineIds:[...current.ids],baselineFootprints:current.footprints,manifestFiles,units:next.units});
 for(const [key,ids] of [['changed_ids',chain.changedIds],['removed_ids',chain.retiredIds],['added_ids',chain.addedIds]])if(!sameIds(exactIds(sourceReceipt[key],key),ids))throw Error('Compound receipt '+key+' differs from validated geometry sequence');
