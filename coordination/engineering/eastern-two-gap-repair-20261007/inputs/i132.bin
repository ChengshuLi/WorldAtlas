 const old=new Map(current.features.map(f=>[f.id,f])),now=new Map(next.features.map(f=>[f.id,f])),changed=new Set(current.features.filter(f=>now.has(f.id)&&frozenGeometry(f)!==frozenGeometry(now.get(f.id))).map(f=>f.id)),removed=new Set(current.features.filter(f=>!now.has(f.id)).map(f=>f.id));
 if(!sameIds(changed,chain.changedIds)||!sameIds(removed,chain.retiredIds))throw Error('Compound changes do not match exact current/final identities');
