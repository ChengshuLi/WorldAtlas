 const rowParts=manifest.parts.filter(p=>p.kind==='rows').sort((a,b)=>a.offset-b.offset),runParts=manifest.parts.filter(p=>p.kind==='runs').sort((a,b)=>a.offset-b.offset);if(rowParts.length+runParts.length!==manifest.parts.length)throw Error('Unknown grid asset kind');const rows=new Uint32Array(manifest.size*2);let offset=0;const decode=part=>{const decoded=unshuffleOwnershipBytes(gunzipSync(fs.readFileSync(checkAsset(opts.grid,part))),part.words);if(hash(Buffer.from(decoded.buffer))!==part.decoded_sha256)throw Error('Decoded grid checksum differs');return decoded;};for(const p of rowParts){if(p.offset!==offset)throw Error('Grid row table has gaps');const words=decode(p);rows.set(words,offset);offset+=words.length;}if(offset!==rows.length)throw Error('Grid row table size mismatch');let totalRuns=0;for(let y=0;y<manifest.size;y++){if(rows[y*2]!==totalRuns)throw Error('Grid rows are not contiguous');totalRuns+=rows[y*2+1];}if(totalRuns*2!==manifest.runWords)throw Error('Grid run count differs from rows');
 const counts=new Float64Array(bounds.length+1),bits=manifest.coordinateBits,mask=2**bits-1,base=2**(32-bits);if(bits!==Math.ceil(Math.log2(manifest.size)))throw Error('Grid coordinate layout differs');offset=0;let y=0,previousEnd=0;for(const p of runParts){if(p.offset!==offset||p.words%2)throw Error('Grid run assets are incomplete');const words=decode(p);for(let k=0;k<words.length;k+=2){const run=(offset+k)/2;while(y<manifest.size&&run>=rows[y*2]+rows[y*2+1]){y++;previousEnd=0;}const a=words[k],b=words[k+1],start=a&mask,end=(b&mask)+1,id=(a>>>bits)+(b>>>bits)*base;if(y>=manifest.size||start<previousEnd||end<=start||end>manifest.size||!idByIndex[id])throw Error('Non-unique/out-of-range grid run');counts[id]+=end-start;previousEnd=end;}offset+=words.length;}if(offset!==manifest.runWords)throw Error('Grid run table size mismatch');
 const assessmentIndex=new Map(assessment.location_ids.map((id,i)=>[id,i]));const actual=new Map(idByIndex.slice(1).map((id,i)=>[id,counts[i+1]]));if(assessment.location_ids.some((id,i)=>actual.get(id)!==assessment.cell_counts[i]||actual.get(id)<1))throw Error('Grid coverage differs from audited per-location counts');let covered=0;const records=next.features.map(f=>{const i=assessmentIndex.get(f.id),cells=actual.get(f.id),source=sourceAreas.areas[f.id],gridArea=assessment.grid_wgs84_area_m2[i];if(!(source>0)||!(gridArea>0))throw Error('Missing geographic land-area proof');covered+=cells;return {id:f.id,name:f.properties.name,owner:f.properties.reference_owner,cells,status:'represented',reason:null,source_wgs84_area_m2:source,grid_wgs84_area_m2:gridArea,source_area_cells:null,relative_area_error:gridArea/source-1};});if(covered!==assessment.covered_cells)throw Error('Grid land-cell totals differ');const pixelAudit={version:2,footprints_sha256:next.footprints,hierarchy_sha256:next.hierarchy,grid_zoom:assessment.zoom,grid_size:manifest.size,locations:records.length,represented:records.length,missing:[],high_distortion:records.filter(r=>Math.abs(r.relative_area_error)>.25),covered_cells:covered,water_or_uncovered_cells:manifest.size**2-covered,background_policy:'Zero ID represents water or unsupported source geography; no arbitrary location reassignment.',area_method:'WGS84 land-footprint and occupied canonical-cell surface areas; projected-area cell estimates are not substituted.',records};return {manifest,pixelAudit};}
export function validate(options){const opts=Object.fromEntries(Object.entries(options).map(([k,v])=>[k,typeof v==='string'&&k!=='expectedValidation'?path.resolve(v):v]));for(const key of ['data','geography','ownership','runtime','references','grid']){if(!fs.statSync(opts[key]).isDirectory())throw Error('Missing input directory');if(key!=='data'&&(opts[key]===opts.data||opts[key].startsWith(opts.data+path.sep)))throw Error('Candidate stage must be separate from live data');}
