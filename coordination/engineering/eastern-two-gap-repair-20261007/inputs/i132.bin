 return {ownership,references,runtime,referenceRecords,sourceReceipt,macroReceipt,geometryProofs,namibia:{locations:beforeNam.length,status:'retained-pending-source-review',reason:'Candidate replacement is blocked; current source identities and footprints remain intact.'}};}
function verifyGrid(opts,next){const manifest=read(path.join(opts.grid,'manifest.json')),assessment=read(opts.gridAudit),sourceAreas=read(opts.gridSourceAreas);if(manifest.footprints_sha256!==next.footprints||manifest.hierarchy_sha256!==next.hierarchy||manifest.stats.locations!==next.ids.size||manifest.version!==2||manifest.size!==assessment.size||assessment.zoom!==Math.log2(manifest.size/256)||assessment.footprints_sha256!==next.footprints||assessment.missing.length||assessment.represented!==next.ids.size||sourceAreas.footprints_sha256!==next.footprints)throw Error('Grid representation or hierarchy evidence is stale');
