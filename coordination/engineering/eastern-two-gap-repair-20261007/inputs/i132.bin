// Install an explicitly reviewed geographic generation. Default operation is read-only.
import fs from 'node:fs';import path from 'node:path';import {createHash,randomUUID} from 'node:crypto';import {gunzipSync} from 'node:zlib';import {fileURLToPath} from 'node:url';
