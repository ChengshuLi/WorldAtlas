  "methods": [
    {
      "id": "geographic-regression",
      "kind": "geography",
      "helper_version": "worldatlas-evidence-geometry-v1",
      "description": "Shared helper normalizes longitude-first source geometry, holes and date-line parts; differential GEOS union/difference/pair intersection reports every positive-area lost coverage/new overlap. Areas in findings are explicitly source-coordinate square degrees, not ellipsoidal m2 metrics. Ellipsoidal helper area is used only by shared canonical-land validity checks. No automatic repair, snapping or water exception.",
      "software": "Python3.12.14/Shapely2.1.2/GEOS3.13.1/pyproj3.7.2; original shared geometry helper at immutable baseline",
      "units": "location/test/finding counts; geometric findings disclose square degrees",
      "axis_order": "longitude-latitude",
      "crs": "EPSG:4326",
      "area_method": "WGS84 straight-source-edge ellipsoidal integral",
      "distance_method": "WGS84 inverse geodesic"
    }
  ],
