  "method": {
    "name": "exact-rational point-in-polygon even-odd ray crossing",
    "numeric_inputs": "Source polygon decimal coordinate tokens are parsed as Decimal and treated as exact rational decimal values. Longitude center is exact rational. Latitude uses the exact rational ratio represented by the pinned binary64 row-table value.",
    "output_semantics": "This tests whether each convention-defined grid sample center lies inside each stored 2017 source polygon. It does not establish an original historical cell class, source/physical contact, admin acceptance, ownership, legal boundary, or sovereignty.",
    "steps": [
      "For each closed ring edge, compute exact cross product; if cross is zero and point lies within edge bounds, return boundary.",
      "For edges straddling the point latitude, compute exact rational longitude crossing; toggle inside when sample longitude is strictly less than the crossing.",
      "Toggle across all rings using even-odd fill; report inside or outside if no boundary hit.",
      "Run against both pinned feature polygons for each key. No epsilon, snapping, buffering, simplification, union, or external geometry library."
    ]
  },
  "grid_cell_center_convention": {
    "cell-center_latitude_formula": "atan(sinh(pi*(1 - 2*(y+0.5)/N))) * 180/pi; computation uses the pinned little-endian float64 row table entry, not runtime regeneration.",
    "grid_width": 262166,
    "native_grid_formula_code": {
      "bytes": 6408,
      "git_blob_sha1": "bc5619798e88b1d2abd4bd11e3fba3b7dd18cf12",
      "path": "src/native-grid.js",
      "sha256": "b54d593b9c6c1144e08cf2d536862dd9a14dd138e1851441dcbe4c487cf2d663"
    },
    "native_row_latitudes": {
      "compressed_bytes": 1851757,
      "compressed_sha256": "ab0becdda100da3473d7bb5d34ccda6510aa1c0490c407082072c7201ad1e147",
      "decoded_bytes": 2097328,
      "decoded_sha256": "66db3d02ede56a75e9c58426ad1388552be3bf7e5e4477476f198983b7436d23",
      "encoding": "little-endian float64, 262166 row entries",
      "git_blob_sha1": "de6905e162dc031b1b93248fae91190c39c4ad53",
      "normative_reference": "local data/pixel-audit.json pins this immutable row-latitude input and grid_size=262166; no ownership values were consulted",
      "path": "coordination/engineering/native-grid-fidelity-1010-20261005-local15/results-v1/native-row-latitudes.f64le.gz"
    },
    "source_code": {
      "bytes": 3699,
      "git_blob_sha1": "008aaf69e65105029e64e09317b8f9aa4df1f352",
      "path": "src/pixel-grid.js",
      "sha256": "ad31039b651e157480eaf0053787b119bdab4b9a2a699e5f6a05d396736c7595"
    },
    "source_method": "projectCell(lon,lat) uses px=(lon+180)/360*GRID_WIDTH and Web Mercator py; rasterize samples cell centers at (x+0.5,y+0.5). Thus CRS84 longitude center is the exact rational -180 + 360*(x+1/2)/N, and row latitude is the pinned native row latitude indexed by y."
  },
