15575902","CDUID":"5917","overlap":0.98889},{"id":"gb:CAN:ADM3:43193130B7119286927713","CDUID":"5917","overlap":0.94483},{"id":"gb:CAN:ADM3:43193130B92511433613937","CDUID":"5917","overlap":0.86068},{"id":"gb:CAN:ADM3:43193130B85114844446103","CDUID":"5917","overlap":0.98991},{"id":"gb:CAN:ADM3:43193130B75749655574079","CDUID":"5931","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B1888301314881","CDUID":"5915","overlap":0.98682},{"id":"gb:CAN:ADM3:43193130B3536991528911","CDUID":"5915","overlap":0.97348},{"id":"gb:CAN:ADM3:43193130B51139526638819","CDUID":"5915","overlap":0.99159},{"id":"gb:CAN:ADM3:43193130B55068753927522","CDUID":"5915","overlap":0.92728},{"id":"gb:CAN:ADM3:43193130B60580601147612","CDUID":"5917","overlap":0.85423},{"id":"gb:CAN:ADM3:43193130B4370182625366","CDUID":"5915","overlap":0.98993},{"id":"gb:CAN:ADM3:43193130B64908747389344","CDUID":"5915","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B7960574436640","CDUID":"5915","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B42698646227552","CDUID":"5915","overlap":0.94701},{"id":"gb:CAN:ADM3:43193130B1655046610974","CDUID":"5915","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B46315615002654","CDUID":"5915","overlap":0.98873},{"id":"gb:CAN:ADM3:43193130B816450651482","CDUID":"5915","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B76902505285067","CDUID":"5924","overlap":1.0},{"id":"gb:CAN:ADM3:43193130B96239326387532","CDUID":"5924","overlap":1.0}],"unresolved_source_names":[],"sources":{"aafc":{"url":"https://www.arcgis.com/home/item.html?id=ee462b0692cc4005aefee69dc44f010d","metadata":{"id":"ee462b0692cc4005aefee69dc44f010d","owner":"EsriCanadaContent","ownerId":"86965bd2a8a547a0a3bfde11b241e147","orgId":"wjcPoefzjpzCgffS","created":1734541188000,"modified":1784732686000,"guid":null,"name":"EcoRegions_of_Canada","title":"EcoRegions of Canada","type":"Feature Service","typeKeywords":["ArcGIS API for JavaScript","ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Service","Singlelayer","Hosted Service"],"description":"<div><div>The&nbsp;<a target='_blank' href='https://open.canada.ca/data/en/dataset/3ef8e8a9-8d05-4fea-a8bf-7f5023d2b6e1' rel='nofollow ugc noopener noreferrer'>National Ecological Framework for Canada&nbsp;</a>provides a consistent, national spatial framework that allows various ecosystems to be described, monitored and reported on. It provides standard ecological units that allow different jurisdictions and disciplines to use common communication and reporting, and a common ground to report on the state of the environment and the sustainability of ecosystems in Canada.</div><div>&nbsp;</div><div>The framework was developed between 1991 and 1999 by the Ecosystems Science Directorate, Environment Canada and the Center for Land and Biological Resources Research, Agriculture and Agri-Food Canada. Over 100 federal and provincial agencies, non-governmental organizations and private sector companies contributed to its development.&nbsp;</div><div>&nbsp;</div><div>More information on the National Ecological Framework of Canada can be fund in the&nbsp;<a target='_blank' href='https://agriculture.canada.ca/atlas/data_donnees/nationalEcologicalFramework/supportdocument_documentdesupport/en/ISO_19131_National_Ecological_Framework_for_Canada_Data_Product_Specification.pdf' rel='nofollow ugc noopener noreferrer'>Data Product Specification.</a></div></div><div>&nbsp;</div><p>The “Terrestrial Ecoregions of Canada” dataset provides representations of ecoregions. An ecoregion is a subdivision of an ecoprovince and is characterized by distinctive regional ecological factors, including climate, physiography, vegetation, soil, water, and fauna. For example, the Maritime Barrens ecoregion (no. 114) is one of nine ecoregions within the Newfoundland ecoprovince.</p><div>&nbsp;</div><div><div><strong>Source:&nbsp;</strong></div><div><a target='_blank' href='https://open.canada.ca/data/en/dataset/ade80d26-61f5-439e-8966-73b352811fe6' rel='nofollow ugc noopener noreferrer'>Terrestrial Ecoregions of Canada</a></div><div><a target='_blank' href='https://agriculture.canada.ca/atlas/data_donnees/nationalEcologicalFramework/supportdocument_documentdesupport/en/ISO_19131_National_Ecological_Framework_for_Canada_Data_Product_Specification.pdf' rel='nofollow ugc noopener noreferrer'>Metadata</a></div><div style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'>&nbsp;</div><div style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'><div style='font-family:inherit;'><strong>Update Frequency:&nbsp;</strong>As needed</div><div style='font-family:inherit;'>&nbsp;</div><div style='font-family:inherit;'><div style='font-family:inherit;'><strong>Related Layers:</strong></div><div style='font-family:inherit;'><ul><li><a target='_blank' href='https://arcgis.com/home/item.html?id=47d35e24ab3f4349b34521c485c37ad1' rel='nofollow ugc noopener noreferrer'>EcoDistricts of Canada</a></li><li><a target='_blank' href='https://arcgis.com/home/item.html?id=501a40ba1aea4e3e96dab4715ce7d5af' rel='nofollow ugc noopener noreferrer'>Ecozones of Canada</a></li><li><a target='_blank' href='https://arcgis.com/home/item.html?id=37a4b193e51e4e499de948e903945e5d' rel='nofollow ugc noopener noreferrer'>EcoProvinces of Canada</a></li></ul></div></div><div style='font-family:inherit;'>&nbsp;</div><div style='font-family:inherit;'><div style='font-family:inherit;'><strong>Contact Information:</strong></div><div style='font-family:inherit;'><ul><li>For inquiries on the data contact&nbsp;Agriculture and Agri-Food Canada (aafc.cansis-siscan.aac@agr.gc.ca)</li><li>For inquires regarding the service, please leave a comment below</li></ul></div></div></div></div>","tags":["Canada","EcoRegions","Ecology","landscape","climate","Ecological Framewokr","esri_canada"],"snippet":"EcoRegions of Canada dataset provides representations of the eco regions within the National Ecological Framework for Canada developed in part by Agriculture and Agri-Food Canada.","thumbnail":"thumbnail/thumbnail1768510868936.png","documentation":null,"extent":[[-140.99944292548292,41.67354582383623],[-52.36457038529885,83.63316615575884]],"categories":["/Categories/Boundaries/Environmental","/Categories/Living Atlas"],"spatialReference":"102100","accessInformation":"Agriculture and Agri-Food Canada","classification":null,"licenseInfo":"<span style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'>Use of this data is subject to the </span><a href='https://open.canada.ca/en/open-government-licence-canada' target='_blank' rel='nofollow ugc noopener noreferrer'>Open Government Licence – Canada</a>","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services.arcgis.com/wjcPoefzjpzCgffS/arcgis/rest/services/EcoRegions_of_Canada/FeatureServer","proxyFilter":null,"access":"public","size":6250496,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"commentsEnabled":true,"numComments":0,"numRatings":0,"avgRating":0,"numViews":16275,"contentStatus":"public_authoritative","scoreCompleteness":100,"groupDesignations":"livingatlas","apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1790838000000},"sha256":"a565563a6aef794df831dc9251fb4108018e20a4f0172acbc36b599f9b7f4abf"},"administrative":"data/administrative-sources.json","physical":{"australia":{"id":"0e78c21ba12543019b92e10272f980fe","owner":"DCCEEW_Geospatial","ownerId":"23a0c3d76d2b4930803bca5dcf8efad8","created":1737086758000,"modified":1739839550000,"guid":null,"name":null,"title":"IBRA7.1 with protection coverage percentages","type":"Feature Service","typeKeywords":["ArcGIS API for JavaScr