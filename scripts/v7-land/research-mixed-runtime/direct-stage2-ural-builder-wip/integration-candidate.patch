+  if kind == 'boundary' and boundary_id != BOUNDARY:
+   if any(ref.get('relationship') in URAL_CONSTRUCTION_INPUTS for ref in record.get('qualified_source_refs', [])):
+    raise ValueError('Ural construction relationship on non-Ural boundary')
