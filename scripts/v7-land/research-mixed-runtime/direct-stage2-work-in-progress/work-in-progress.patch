+    run.append((b,code))
+    if code:
+     x=a
+     while x<b:
+      z=min(b,(x//4+1)*4);p=(y//4,x//4);parts.setdefault(p,[]).append((y,x,z,code));x=z
+    a=b
+   offs.append(len(run))
+  (self.d/'rows').write_bytes(b''.join(struct.pack('<I',x) for x in offs));(self.d/'runs').write_bytes(b''.join(struct.pack('<II',*x) for x in run))
