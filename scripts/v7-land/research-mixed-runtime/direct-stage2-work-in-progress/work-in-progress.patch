+  self.tmp=tempfile.TemporaryDirectory();self.d=pathlib.Path(self.tmp.name);self.tiles=self.d/'tiles';self.tiles.mkdir();rows=[[(2,0),(6,18),(16,0)],[(4,17),(12,0),(16,20)]]+[[(16,0)] for _ in range(6)];offs=[0];run=[];parts={}
